# The web UI authenticates with your Claude subscription by default — the same
# login Claude Code uses (~/.claude/.credentials.json). You do NOT need an API key.
#
# Set a key here ONLY if you'd rather bill usage to the Anthropic API instead of
# your subscription. When present, it takes over.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: port for the local dev server (default 3000).
# PORT=3000
