# You normally DON'T need this file at all.
#
# The slopify web UI runs on your Claude subscription by default — the same login
# Claude Code uses (~/.claude/.credentials.json). No API key, no config required:
# just `claude login` once, then start the app.
#
# This file exists only for two optional overrides. To use one, copy this file to
# `.env` and uncomment the relevant line:

# Bill usage to the Anthropic API instead of your subscription (takes over when set):
# ANTHROPIC_API_KEY=sk-ant-...

# Run the local server on a different port (default 3000):
# PORT=3000
